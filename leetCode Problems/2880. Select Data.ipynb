   "source": [
    "students = {\n",
    "    \"student_id\" : [101, 53, 128, 3],\n",
    "    \"name\" : [\"Ulysses\", \"William\", \"Henry\", \"Henry\"],\n",
    "    \"age\" : [13, 10, 6, 11]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(students)\n",
    "df = df.loc[df[\"student_id\"] == 101, [\"name\", \"age\"]]\n",
    "df"
