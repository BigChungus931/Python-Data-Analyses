   "source": [
    "employee = {\n",
    "    \"name\" : [\"Jack\", \"Piper\", \"Mia\", \"Ulysses\"],\n",
    "    \"salary\" : [19666, 74754, 62509, 54866]\n",
    "}\n",
    "\n",
    "employees = pd.DataFrame(employee)\n",
    "\n",
    "employees[\"salary\"] = employees[\"salary\"] * 2\n",
