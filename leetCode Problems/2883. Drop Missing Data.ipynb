   "source": [
    "student = {\n",
    "    \"student_id\" : [32, 217, 779, 849],\n",
    "    \"name\" : [\"Piper\", None, \"Georgia\", \"Willow\"],\n",
    "    \"age\" : [5, 19, 20, 14]\n",
    "}\n",
    "\n",
    "students = pd.DataFrame(student)\n",
    "\n",
    "students = students.dropna(subset=\"name\")\n",
    "\n",
    "students"
